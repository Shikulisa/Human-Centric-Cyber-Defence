{
  "manifest_version": 3,
  "name": "Flagit - Gmail Phishing Helper",
  "version": "2.1.0",
  "description": "Classifies Gmail emails as phishing or legitimate and lets admins send feedback in bulk.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Flagit",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

